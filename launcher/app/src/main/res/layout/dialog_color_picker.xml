<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/color_dialog_container"
        android:layout_width="480dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_cyber_dialog"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/color_dialog_accent_strip"
                    android:layout_width="5dp"
                    android:layout_height="28dp"
                    android:background="#00E5FF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACCENT COLOR PALETTE"
                        android:textColor="#00E5FF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/color_dialog_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET: SMARTTUBE"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="NEON FREQUENCY // MATRIX"
                android:textColor="#475569"
                android:textSize="8sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            android:background="#22334A" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="/// SELECT NEON WAVELENGTH FOR SHARD HUD"
            android:textColor="#FFE600"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Scrollable list of colors -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/color_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="#22334A" />

        <!-- Footer Control Hint -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="[OK] APPLY COLOR  ·  [BACK] CANCEL"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="SHARD_HUD // CHROMATIC"
                android:textColor="#334155"
                android:textSize="7.5sp" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
