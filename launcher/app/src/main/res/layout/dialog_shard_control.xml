<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AA07090D"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center">

    <LinearLayout
        android:id="@+id/dialog_container"
        android:layout_width="440dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_cyber_dialog"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Top Header Bar -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/dialog_accent_strip"
                    android:layout_width="5dp"
                    android:layout_height="28dp"
                    android:background="#FFE600" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA SHARD CONTROL"
                        android:textColor="#FFE600"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                    <TextView
                        android:id="@+id/dialog_app_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TARGET: SMARTTUBE"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="SAMURAI_OS // v7.77"
                android:textColor="#475569"
                android:textSize="8sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#22334A" />

        <!-- Protocol Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="/// SYSTEM PROTOCOL: SELECT SHARD ACTION"
            android:textColor="#00E5FF"
            android:textSize="8.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Option 1: MOVE -->
        <LinearLayout
            android:id="@+id/btn_dialog_move"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/icon_dialog_move_box"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/icon_dialog_move"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⇄"
                    android:textColor="#FFE600"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_dialog_move_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MOVE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/text_dialog_move_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REPOSITION LIVE VIA D-PAD ARROWS"
                    android:textSize="8sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_dialog_move"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ REORDER ]"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Option 2: CHANGE COLOR -->
        <LinearLayout
            android:id="@+id/btn_dialog_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <FrameLayout
                android:id="@+id/icon_dialog_color_box"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical">

                <TextView
                    android:id="@+id/icon_dialog_color"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🎨"
                    android:textSize="16sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_dialog_color_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHANGE COLOR"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/text_dialog_color_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CUSTOMIZE SHARD ACCENT &amp; NEON GLOW"
                    android:textSize="8sp"
                    android:letterSpacing="0.04" />
            </LinearLayout>

            <TextView
                android:id="@+id/badge_dialog_color"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ PALETTE ]"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Footer Control Hint -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="[OK] SELECT ACTION  ·  [BACK] DISMISS"
                android:textColor="#64748B"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="NETRUNNER_AUTH // 2077"
                android:textColor="#334155"
                android:textSize="7.5sp" />
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>
