<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sec_card_root"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:clickable="true">

    <RelativeLayout
        android:id="@+id/sec_card_inner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="8dp">

        <TextView
            android:id="@+id/sec_card_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:text="SHARD //"
            android:textColor="@color/cyber_text_secondary"
            android:textSize="7.5sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/sec_card_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true" />

        <TextView
            android:id="@+id/sec_card_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:text="APP NAME"
            android:textColor="@color/cyber_cyan"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/sec_card_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:text="OPEN // ▲ PROMOTE"
            android:textColor="@color/cyber_text_muted"
            android:textSize="7sp"
            android:textStyle="bold"
            android:singleLine="true" />
    </RelativeLayout>

    <!-- Directional Move Arrows (Visible only during Move Mode) -->
    <TextView
        android:id="@+id/sec_arrow_up"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="-12dp"
        android:background="@drawable/bg_cyber_arrow"
        android:elevation="30dp"
        android:gravity="center"
        android:text="▲"
        android:textColor="#090B0E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sec_arrow_down"
        android:layout_width="36dp"
        android:layout_height="24dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="-12dp"
        android:background="@drawable/bg_cyber_arrow"
        android:elevation="30dp"
        android:gravity="center"
        android:text="▼"
        android:textColor="#090B0E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sec_arrow_left"
        android:layout_width="24dp"
        android:layout_height="36dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="-12dp"
        android:background="@drawable/bg_cyber_arrow"
        android:elevation="30dp"
        android:gravity="center"
        android:text="◀"
        android:textColor="#090B0E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sec_arrow_right"
        android:layout_width="24dp"
        android:layout_height="36dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="-12dp"
        android:background="@drawable/bg_cyber_arrow"
        android:elevation="30dp"
        android:gravity="center"
        android:text="▶"
        android:textColor="#090B0E"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
