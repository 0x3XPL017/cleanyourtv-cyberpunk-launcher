<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Samurai" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/cyber_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/cyber_bg</item>
        <item name="android:navigationBarColor">@color/cyber_bg</item>
    </style>

    <style name="Theme.CyberDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.75</item>
    </style>
</resources>
